<?xml version="1.0" encoding="utf-8"?>
<!--
    Certificados del proveedor de Google Fonts (com.google.android.gms).
    Generados por Android Studio al usar "Downloadable Fonts".
    Si la verificación falla (cert incorrecto para este dispositivo),
    las fuentes vuelven al sistema sin crash.
-->
<resources>
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>

    <!-- Certificado de depuración (builds debug) -->
    <string-array name="com_google_android_gms_fonts_certs_dev">
        <item></item>
    </string-array>

    <!-- Certificado de producción (Play Services en dispositivos reales) -->
    <string-array name="com_google_android_gms_fonts_certs_prod">
        <item></item>
    </string-array>
</resources>
